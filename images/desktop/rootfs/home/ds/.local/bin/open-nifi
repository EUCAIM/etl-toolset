#!/usr/bin/env bash

echo "Downloading certificate..."
echo "" | openssl s_client -connect nifi-nifi:8443 2>/dev/null | openssl x509 > /tmp/nifi-cert.crt

echo ""
echo "We are going to open the browser."
if [ -n "$NIFI_USERNAME" ]; then
    echo "You will be able to log in with..."
    echo "Username: $NIFI_USERNAME"
    echo "Password: $NIFI_PASSWORD"
    echo ""
    echo "Press [enter] to continue"
    read
fi

echo "Opening the browser..."
nohup firefox https://nifi-nifi:8443/
