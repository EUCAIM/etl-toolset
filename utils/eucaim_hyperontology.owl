    <!-- https://cancerimage.eu/ontology/EUCAIM#BP1000112 -->


    <owl:Class rdf:about="https://cancerimage.eu/ontology/EUCAIM#BP1000112">
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#BP1000034"/>
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#BP1000088"/>
        <rdfs:label xml:lang="en">Knee</rdfs:label>
        <skos:altLabel>Knee region structure</skos:altLabel>
        <skos:altLabel>Knee region structure (body structure)</skos:altLabel>
        <skos:altLabel>genu</skos:altLabel>
        <skos:definition>A joint connecting the lower part of the femur with the upper part of the tibia. The lower part of the femur and the upper part of the tibia are attached to each other by ligaments. Other structures of the knee joint include the upper part of the fibula, located below and parallel to the tibia, and the patella which moves as the knee bends. [NCIT]</skos:definition>
        <skos:definition>The body part defined by the knee joint and its surrounding structures</skos:definition>
        <skos:exactMatch>NCIT:C32898</skos:exactMatch>
        <skos:exactMatch>RADLEX:RID2743</skos:exactMatch>
        <skos:exactMatch>UMLS:C1963703</skos:exactMatch>
        <skos:prefLabel xml:lang="en">Knee</skos:prefLabel>
        <NCIT>C32898</NCIT>
        <RadLex>RID2743</RadLex>
        <SNOMEDCT>72696002</SNOMEDCT>
        <UMLS_CUI>C1963703</UMLS_CUI>
        <source>SNOMEDCT:72696002</source>
    </owl:Class>
    


    <!-- https://cancerimage.eu/ontology/EUCAIM#BP1000113 -->


    <owl:Class rdf:about="https://cancerimage.eu/ontology/EUCAIM#BP1000113">
        <owl:equivalentClass rdf:resource="https://cancerimage.eu/ontology/EUCAIM#CLIN1063787"/>
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#BP1000014"/>
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#BP1000164"/>
