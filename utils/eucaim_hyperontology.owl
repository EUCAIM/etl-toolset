    <owl:Class rdf:about="https://cancerimage.eu/ontology/EUCAIM#BP1000209">
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#BP1000023"/>
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#BP1000030"/>
