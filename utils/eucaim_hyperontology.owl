    <!-- https://cancerimage.eu/ontology/EUCAIM#IMG1016690 -->


    <owl:Class rdf:about="https://cancerimage.eu/ontology/EUCAIM#IMG1016690">
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#GEN1000026"/>
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#IMG1000001"/>
        <rdfs:label>Density descriptor</rdfs:label>
        <skos:definition>[BI-RADS] This is used to define the x-ray attenuation of the lesion relative to the expected attenuation of an equal volume of fibroglandular breast tissue. It is important that most breast cancers that form a visible mass are of equal or higher density than an equal volume of fibroglandular tissue. it is rare (although not impossible) for breast cancer to be lower in density. breast cancers are never fat-containing (radiolucent) although they may trap fat. [RadLex]</skos:definition>
        <skos:prefLabel>Density descriptor</skos:prefLabel>
        <RadLex>RID6041</RadLex>
        <source>RadLex:RID6041</source>
    </owl:Class>
    


