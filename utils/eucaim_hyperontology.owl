    <!-- https://cancerimage.eu/ontology/EUCAIM#CLIN1043447 -->


    <owl:Class rdf:about="https://cancerimage.eu/ontology/EUCAIM#CLIN1043447">
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#CLIN1038137"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cancerimage.eu/ontology/EUCAIM#ComorbidityAssociatedWith"/>
                <owl:someValuesFrom rdf:resource="https://cancerimage.eu/ontology/EUCAIM#CLIN1000071"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cancerimage.eu/ontology/EUCAIM#hasAssociatedMorphology"/>
                <owl:someValuesFrom rdf:resource="https://cancerimage.eu/ontology/EUCAIM#CLIN1049516"/>
            </owl:Restriction>
        </rdfs:subClassOf>
