            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cancerimage.eu/ontology/EUCAIM#hasCorrespondence"/>
                <owl:someValuesFrom rdf:resource="https://cancerimage.eu/ontology/EUCAIM#COR1000023"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cancerimage.eu/ontology/EUCAIM#hasCorrespondence"/>
                <owl:someValuesFrom rdf:resource="https://cancerimage.eu/ontology/EUCAIM#COR1000100"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Docetaxel</rdfs:label>
        <skos:altLabel>Docecad</skos:altLabel>
        <skos:altLabel>Docetaxel (substance)</skos:altLabel>
        <skos:altLabel>N-Debenzoyl-N-(tert-butoxycarbonyl)-10-deacetyltaxol</skos:altLabel>
        <skos:altLabel>RP 56976</skos:altLabel>
        <skos:altLabel>RP56976</skos:altLabel>
        <skos:altLabel>Taxotere</skos:altLabel>
        <skos:altLabel>Taxotere Injection Concentrate</skos:altLabel>
        <skos:definition>A semi-synthetic, second-generation taxane derived from a compound found in the European yew tree, Taxus baccata.  Docetaxel displays potent and broad antineoplastic properties; it binds to and stabilizes tubulin, thereby inhibiting microtubule disassembly which results in cell- cycle arrest at the G2/M phase and cell death.  This agent also inhibits pro-angiogenic factors such as vascular endothelial growth factor (VEGF) and displays immunomodulatory and pro-inflammatory properties by inducing various mediators of the inflammatory response.  Docetaxel has been studied for use as a radiation-sensitizing agent. (NCI04)</skos:definition>
        <skos:exactMatch>NCIT:C1526</skos:exactMatch>
        <skos:exactMatch>SNOMEDCT:386918005</skos:exactMatch>
        <skos:prefLabel>Docetaxel</skos:prefLabel>
        <CDM>FHIR</CDM>
        <FHIR_ResourceType>Medication Administration</FHIR_ResourceType>
        <NCIT>C1526</NCIT>
        <OMOP_Concept_Class_ID>Substance</OMOP_Concept_Class_ID>
        <OMOP_Concept_ID>4305104</OMOP_Concept_ID>
        <OMOP_Concept_Name>Docetaxel</OMOP_Concept_Name>
        <OMOP_Concept_code>386918005</OMOP_Concept_code>
        <OMOP_Domain_ID>Drug</OMOP_Domain_ID>
        <OMOP_Vocabulary_ID>SNOMED</OMOP_Vocabulary_ID>
        <RxNorm>72962</RxNorm>
        <source>RxNorm:72962</source>
    </owl:Class>
    


