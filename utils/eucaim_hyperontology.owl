    <!-- https://cancerimage.eu/ontology/EUCAIM#BP1000006 -->


    <owl:Class rdf:about="https://cancerimage.eu/ontology/EUCAIM#BP1000006">
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#BP1000149"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cancerimage.eu/ontology/EUCAIM#hasCorrespondence"/>
                <owl:someValuesFrom rdf:resource="https://cancerimage.eu/ontology/EUCAIM#COR1000077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Peripheral zone of prostate</rdfs:label>
        <skos:altLabel>Peripheral Zone</skos:altLabel>
        <skos:altLabel>Peripheral glandular zone of prostate</skos:altLabel>
        <skos:altLabel>Peripheral zone</skos:altLabel>
        <skos:altLabel>Structure of peripheral glandular zone of prostate</skos:altLabel>
        <skos:altLabel>Structure of peripheral glandular zone of prostate (body structure)</skos:altLabel>
        <skos:altLabel>periurethral prostate gland</skos:altLabel>
        <skos:altLabel>posterior lamella of prostate</skos:altLabel>
        <skos:definition>PI-RADS: The peripheral zone covers the outer posterior, lateral, and apex regions of the prostate. It makes up most of the apex of the prostate. [RADLEX]</skos:definition>
        <skos:definition>The region of the prostate that is located most superficial and posterior as compared to the other prostate zones. It is located closest to the rectum, and is easily palpated on digital rectal exam. This zone of the prostate surrounds the distal urethra, and is the zone of origin for the vast majority of prostatic cancers. [NCIT]</skos:definition>
        <skos:exactMatch>NCIT:C128570</skos:exactMatch>
        <skos:exactMatch>RADLEX:RID347</skos:exactMatch>
        <skos:exactMatch>UMLS:C0458696</skos:exactMatch>
        <skos:prefLabel>Peripheral zone of prostate</skos:prefLabel>
        <NCIT>C128570</NCIT>
        <OMOP_Concept_Class_ID>Body Structure</OMOP_Concept_Class_ID>
        <OMOP_Concept_ID>4088951</OMOP_Concept_ID>
        <OMOP_Concept_Name>Peripheral zone of prostate</OMOP_Concept_Name>
        <OMOP_Concept_code>279706003</OMOP_Concept_code>
        <OMOP_Domain_ID>Spec Anatomic Site</OMOP_Domain_ID>
        <OMOP_Vocabulary_ID>SNOMED</OMOP_Vocabulary_ID>
        <RadLex>RID347</RadLex>
        <SNOMEDCT>279706003</SNOMEDCT>
        <UMLS_CUI>C0458696</UMLS_CUI>
        <acronym>PZ</acronym>
        <queryCriteria rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</queryCriteria>
        <source>SNOMEDCT:279706003</source>
    </owl:Class>
    


    <!-- https://cancerimage.eu/ontology/EUCAIM#BP1000007 -->


    <owl:Class rdf:about="https://cancerimage.eu/ontology/EUCAIM#BP1000007">
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#BP1000228"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cancerimage.eu/ontology/EUCAIM#hasCorrespondence"/>
