            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cancerimage.eu/ontology/EUCAIM#hasMeasurementUnit"/>
                <owl:someValuesFrom rdf:resource="https://cancerimage.eu/ontology/EUCAIM#COM1001957"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>CT Imaging Acquisition Protocol Element CTDI VOL</rdfs:label>
        <skos:definition>The average dose over the total volume scanned for the selected CT conditions of operation (calculated according to IEC 60601-2-44, Ed.2.1 (Clause 29.1.103.4)). EXAMPLE(S): OTHER NAME(S): Computed Tomography Dose Index (CTDI) Volume NOTE(S): The units are energy dose, e.g. mGy. [NCIT]</skos:definition>
        <skos:prefLabel>CT Imaging Acquisition Protocol Element CTDI VOL</skos:prefLabel>
        <source>NCIT:C164735</source>
    </owl:Class>
    


    <!-- https://cancerimage.eu/ontology/EUCAIM#IMG1000144 -->


