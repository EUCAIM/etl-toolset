                <owl:someValuesFrom rdf:resource="https://cancerimage.eu/ontology/EUCAIM#COR1000100"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Vinorelbine</rdfs:label>
        <skos:altLabel>Vinorelbine (substance)</skos:altLabel>
        <skos:altLabel>nor-5&apos;-Anhydrovinblastine</skos:altLabel>
        <skos:definition>A semisynthetic vinca alkaloid. Vinorelbine binds to tubulin and prevents formation of the mitotic spindle, resulting in the arrest of tumor cell growth in metaphase. This agent may also interfere with amino acid, cyclic AMP. and glutathione metabolism; calmodulin-dependent Ca++ -transport ATPase activity; cellular respiration; and nucleic acid and lipid biosynthesis. [NCIT]</skos:definition>
        <skos:exactMatch>NCIT:C1275</skos:exactMatch>
        <skos:exactMatch>SNOMEDCT:372541004</skos:exactMatch>
        <skos:prefLabel>Vinorelbine</skos:prefLabel>
        <CDM>FHIR</CDM>
        <FHIR_ResourceType>Medication Administration</FHIR_ResourceType>
        <NCIT>C1275</NCIT>
        <OMOP_Concept_Class_ID>Substance</OMOP_Concept_Class_ID>
        <OMOP_Concept_ID>4159316</OMOP_Concept_ID>
        <OMOP_Concept_Name>Vinorelbine</OMOP_Concept_Name>
        <OMOP_Concept_code>372541004</OMOP_Concept_code>
        <OMOP_Domain_ID>Drug</OMOP_Domain_ID>
        <OMOP_Vocabulary_ID>SNOMED</OMOP_Vocabulary_ID>
        <RxNorm>39541</RxNorm>
        <source>RxNorm:39541</source>
    </owl:Class>
    


