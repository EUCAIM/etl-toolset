        <OMOP_Concept_code>113091000</OMOP_Concept_code>
        <OMOP_Domain_ID>Procedure</OMOP_Domain_ID>
        <OMOP_Vocabulary_ID>SNOMED</OMOP_Vocabulary_ID>
