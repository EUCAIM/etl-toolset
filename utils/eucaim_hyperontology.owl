    </owl:Class>
    


    <!-- https://cancerimage.eu/ontology/EUCAIM#IMG1004473 -->


    <owl:Class rdf:about="https://cancerimage.eu/ontology/EUCAIM#IMG1004473">
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#IMG1004472"/>
        <rdfs:label>T1-Weighted Magnetic Resonance Imaging with Contrast</rdfs:label>
        <skos:altLabel>T1-Weighted MRI with Contrast</skos:altLabel>
        <skos:altLabel>T1W MRI with Contrast</skos:altLabel>
