        <OMOP_Concept_code>386905002</OMOP_Concept_code>
        <OMOP_Domain_ID>Drug</OMOP_Domain_ID>
        <OMOP_Vocabulary_ID>SNOMED</OMOP_Vocabulary_ID>
        <RxNorm>40048</RxNorm>
        <source>RxNorm:40048</source>
    </owl:Class>
    


