        <skos:altLabel>MRI</skos:altLabel>
        <skos:altLabel>Magnetic resonance imaging - action</skos:altLabel>
        <skos:altLabel>Magnetic resonance imaging - action (qualifier value)</skos:altLabel>
        <skos:altLabel>Magnetic resonance technique</skos:altLabel>
        <skos:definition>Non-invasive method of demonstrating internal anatomy based on the principle that atomic nuclei in a strong magnetic field absorb pulses of radiofrequency energy and emit them as radiowaves which can be reconstructed into computerized images. The concept includes proton spin tomographic techniques. [MeSH]</skos:definition>
        <skos:exactMatch>SNOMEDCT:312250003</skos:exactMatch>
        <skos:prefLabel>Magnetic resonance imaging</skos:prefLabel>
        <OMOP_Concept_Class_ID>Qualifier Value</OMOP_Concept_Class_ID>
