        <rdfs:label>Malignant neoplasm of breast</rdfs:label>
        <skos:altLabel xml:lang="en">Breast cancer</skos:altLabel>
        <skos:altLabel>CA - Breast cancer</skos:altLabel>
        <skos:altLabel>Malignant neoplasm of breast (disorder)</skos:altLabel>
        <skos:altLabel>Malignant tumor of breast</skos:altLabel>
        <skos:altLabel>Malignant tumour of breast</skos:altLabel>
        <skos:definition>A carcinoma arising from the breast, most commonly the terminal ductal-lobular unit. It is the most common malignant tumor in females. Risk factors include country of birth, family history, menstrual and reproductive history, fibrocystic disease and epithelial hyperplasia, exogenous estrogens, contraceptive agents, and ionizing radiation. The vast majority of breast carcinomas are adenocarcinomas (ductal or lobular). Breast carcinoma spreads by direct invasion, by the lymphatic route, and by the blood vessel route. The most common site of lymph node involvement is the axilla. [NCIT]</skos:definition>
        <skos:exactMatch>ICDO3:8000/3-C50.9</skos:exactMatch>
        <skos:exactMatch>NCIT:C4872</skos:exactMatch>
        <skos:exactMatch>RADLEX:RID45682</skos:exactMatch>
        <skos:exactMatch>SNOMEDCT:254837009</skos:exactMatch>
        <skos:exactMatch>UMLS:C0006142</skos:exactMatch>
        <skos:prefLabel>Malignant neoplasm of breast</skos:prefLabel>
        <ICD10>C50</ICD10>
        <ICDO3>8000/3-C50.9</ICDO3>
        <NCIT>C4872</NCIT>
        <OMOP_Concept_Class_ID>ICD10 Hierarchy</OMOP_Concept_Class_ID>
        <OMOP_Concept_ID>45571518</OMOP_Concept_ID>
        <OMOP_Concept_Name>Malignant neoplasm of breast</OMOP_Concept_Name>
        <OMOP_Concept_code>C50</OMOP_Concept_code>
        <OMOP_Domain_ID>Condition</OMOP_Domain_ID>
        <OMOP_Vocabulary_ID>ICD10</OMOP_Vocabulary_ID>
        <RadLex>RID45682</RadLex>
        <SNOMEDCT>254837009</SNOMEDCT>
        <UMLS_CUI>C0006142</UMLS_CUI>
        <queryCriteria rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</queryCriteria>
        <source>ICD10:C50</source>
    </owl:Class>
    


