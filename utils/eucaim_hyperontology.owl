    <owl:Class rdf:about="https://cancerimage.eu/ontology/EUCAIM#BP1000238">
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#BP1000252"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cancerimage.eu/ontology/EUCAIM#hasCorrespondence"/>
                <owl:someValuesFrom rdf:resource="https://cancerimage.eu/ontology/EUCAIM#COR1000077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Cross-sectional pelvis</rdfs:label>
        <skos:altLabel>Pelvic cross-sectional segment of trunk</skos:altLabel>
        <skos:altLabel>Structure of pelvic cross-sectional segment of trunk</skos:altLabel>
        <skos:altLabel>Structure of pelvic cross-sectional segment of trunk (body structure)</skos:altLabel>
        <skos:definition>This cross-sectional segment is bounded superiorly by a virtual horizontal plane at the level of the plane traversing the superior boundary of the iliac crest; and inferiorly it extends to the perineum and includes part but not necessarily the entire external genitalia. The segment includes the volume of the true and false pelvic cavities (and also part of the lower abdominal volume below the level of the virtual superior boundary). The volume includes the entire transverse thickness of the body over the longitudinal extent between the superior (upper) and inferior (lower) boundaries including the skin and subcutaneous tissue. The segment relates to the cross-sectional or projectional volume as perceived by transmissive or emissive imaging. [SNOMEDCT]</skos:definition>
        <skos:exactMatch>UMLS:C5230955</skos:exactMatch>
        <skos:prefLabel>Cross-sectional pelvis</skos:prefLabel>
        <OMOP_Concept_Class_ID>Body Structure</OMOP_Concept_Class_ID>
        <OMOP_Concept_ID>37303886</OMOP_Concept_ID>
        <OMOP_Concept_Name>Cross-sectional pelvis</OMOP_Concept_Name>
        <OMOP_Concept_code>816092008</OMOP_Concept_code>
        <OMOP_Domain_ID>Spec Anatomic Site</OMOP_Domain_ID>
        <OMOP_Vocabulary_ID>SNOMED</OMOP_Vocabulary_ID>
        <SNOMEDCT>816092008</SNOMEDCT>
        <UMLS_CUI>C5230955</UMLS_CUI>
        <source>SNOMEDCT:816092008</source>
    </owl:Class>
    


