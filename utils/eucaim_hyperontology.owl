    <!-- https://cancerimage.eu/ontology/EUCAIM#BP1000168 -->


    <owl:Class rdf:about="https://cancerimage.eu/ontology/EUCAIM#BP1000168">
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#BP1000149"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cancerimage.eu/ontology/EUCAIM#hasCorrespondence"/>
                <owl:someValuesFrom rdf:resource="https://cancerimage.eu/ontology/EUCAIM#COR1000077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Central zone of prostate</rdfs:label>
        <skos:altLabel>Central Zone</skos:altLabel>
        <skos:altLabel>Central zone</skos:altLabel>
        <skos:altLabel>Innermost glandular zone of prostate</skos:altLabel>
        <skos:altLabel>Structure of innermost glandular zone of prostate</skos:altLabel>
        <skos:altLabel>Structure of innermost glandular zone of prostate (body structure)</skos:altLabel>
        <skos:definition>PI-RADS: The central zone is the region of the prostate surrounding the ejaculatory ducts posterior and superior, from the base of the prostate to the verumontanum. Its lateral border fuses with the proximal peripheral zone border at the prostate base. It has the shape of an inverted cone with its base oriented towards the base of the gland.  It contains about 20% of the glandular tissue. It contains more stroma than glandular tissue.

The term “central gland” refers to the central zone and the transition zone combined. The use of this term is discouraged. If the central zone is not seen as a distinct regional part, then a finding in this region should be localized to the transition zone. [RADLEX]</skos:definition>
        <skos:definition>This region of the prostate gland that is located between the peripheral and transition zones, surrounding the ejaculatory ducts. It gives rise to a very small percentage of prostate cancers, though these cancers are frequently more aggressive, often resulting in invasion of the seminal vesicles. [NCIT]</skos:definition>
        <skos:exactMatch>NCIT:C128572</skos:exactMatch>
        <skos:exactMatch>RADLEX:RID348</skos:exactMatch>
        <skos:exactMatch>UMLS:C0458698</skos:exactMatch>
        <skos:prefLabel>Central zone of prostate</skos:prefLabel>
        <NCIT>C128572</NCIT>
        <OMOP_Concept_Class_ID>Body Structure</OMOP_Concept_Class_ID>
        <OMOP_Concept_ID>4089569</OMOP_Concept_ID>
        <OMOP_Concept_Name>Central zone of prostate</OMOP_Concept_Name>
        <OMOP_Concept_code>1351331008</OMOP_Concept_code>
        <OMOP_Domain_ID>Spec Anatomic Site</OMOP_Domain_ID>
        <OMOP_Vocabulary_ID>SNOMED</OMOP_Vocabulary_ID>
        <RadLex>RID348</RadLex>
        <SNOMEDCT>1351331008</SNOMEDCT>
        <UMLS_CUI>C0458698</UMLS_CUI>
        <acronym>CZ</acronym>
        <queryCriteria rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</queryCriteria>
        <source>SNOMEDCT:1351331008</source>
    </owl:Class>
    


