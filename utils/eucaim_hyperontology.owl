        <skos:definition>A carcinoma originating in the lung. Lung carcinomas usually arise from the epithelium that lines the bronchial tree (bronchogenic carcinomas), and are classified as small cell or non-small cell carcinomas. Non-small cell lung carcinomas are usually adenocarcinomas, squamous cell carcinomas, or large cell carcinomas. Metastatic carcinomas to the lung are also common, and can be difficult to distinguish from primary tumors. [NCIT]</skos:definition>
        <skos:exactMatch>NCIT:C4878</skos:exactMatch>
        <skos:exactMatch>SNOMEDCT:363358000</skos:exactMatch>
        <skos:exactMatch>UMLS:C0242379</skos:exactMatch>
        <skos:prefLabel xml:lang="en">Malignant tumor of lung</skos:prefLabel>
        <NCIT>C4878</NCIT>
        <SNOMEDCT>363358000</SNOMEDCT>
        <UMLS_CUI>C0242379</UMLS_CUI>
        <queryCriteria rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</queryCriteria>
        <source>SNOMEDCT:363358000</source>
    </owl:Class>
    


    <!-- https://cancerimage.eu/ontology/EUCAIM#CLIN1000066 -->


    <owl:Class rdf:about="https://cancerimage.eu/ontology/EUCAIM#CLIN1000066">
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#CLIN1000113"/>
        <rdfs:subClassOf rdf:resource="https://cancerimage.eu/ontology/EUCAIM#CLIN1000132"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cancerimage.eu/ontology/EUCAIM#hasCorrespondence"/>
                <owl:someValuesFrom rdf:resource="https://cancerimage.eu/ontology/EUCAIM#COR1000043"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Neuroblastoma (morphologic abnormality)</rdfs:label>
        <skos:altLabel>Central neuroblastoma</skos:altLabel>
        <skos:altLabel>NB - Neuroblastoma</skos:altLabel>
        <skos:altLabel>Neuroblastoma (morphologic abnormality)</skos:altLabel>
        <skos:altLabel>Schwannian stroma-poor peripheral neuroblastic neoplasm</skos:altLabel>
        <skos:definition>A common neoplasm of early childhood arising from neural crest cells in the sympathetic nervous system, and characterized by diverse clinical behavior, ranging from spontaneous remission to rapid metastatic progression and death. This tumor is the most common intraabdominal malignancy of childhood, but it may also arise from thorax, neck, or rarely occur in the central nervous system. Histologic features include uniform round cells with hyperchromatic nuclei arranged in nests and separated by fibrovascular septa. Neuroblastomas may be associated with the opsoclonus-myoclonus syndrome. (From DeVita et al., Cancer: Principles and Practice of Oncology, 5th ed, pp2099-2101; Curr Opin Oncol 1998 Jan;10(1):43-51) [MeSH]</skos:definition>
        <skos:definition>A malignant neuroblastic tumor characterized by the presence of neuroblastic cells, the absence of ganglion cells, and the absence of a prominent Schwannian stroma formation. [NCIT]</skos:definition>
        <skos:exactMatch>NCIT:C3270</skos:exactMatch>
        <skos:exactMatch>RADLEX:RID4454</skos:exactMatch>
        <skos:exactMatch>SNOMEDCT:87364003</skos:exactMatch>
        <skos:exactMatch>UMLS:C0027819</skos:exactMatch>
        <skos:prefLabel xml:lang="en">Neuroblastoma (morphologic abnormality)</skos:prefLabel>
        <NCIT>C3270</NCIT>
        <OMOP_Concept_Class_ID>Morph Abnormality</OMOP_Concept_Class_ID>
        <OMOP_Concept_ID>4337398</OMOP_Concept_ID>
        <OMOP_Concept_Name>Neuroblastoma (morphologic abnormality)</OMOP_Concept_Name>
        <OMOP_Concept_code>87364003</OMOP_Concept_code>
        <OMOP_Domain_ID>Observation</OMOP_Domain_ID>
        <OMOP_Vocabulary_ID>SNOMED</OMOP_Vocabulary_ID>
        <RadLex>RID4454</RadLex>
        <SNOMEDCT>87364003</SNOMEDCT>
        <UMLS_CUI>C0027819</UMLS_CUI>
