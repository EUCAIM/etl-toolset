        </rdfs:subClassOf>
        <rdfs:label>Exemestane</rdfs:label>
        <skos:altLabel>Aromasin</skos:altLabel>
        <skos:altLabel>Exemestane (substance)</skos:altLabel>
        <skos:altLabel>FCE-24304</skos:altLabel>
        <skos:definition>An irreversible steroidal aromatase inhibitor, with antiestrogen and antineoplastic activities. Upon oral administration, exemestane binds irreversibly to and inhibits the enzyme aromatase, thereby blocking the peripheral aromatization of androgens, including androstenedione and testosterone, to estrogens. This lowers estrogen levels in the blood circulation. [NCIT]</skos:definition>
        <skos:exactMatch>NCIT:C1097</skos:exactMatch>
        <skos:exactMatch>SNOMEDCT:387017005</skos:exactMatch>
        <skos:prefLabel>Exemestane</skos:prefLabel>
        <CDM>FHIR</CDM>
        <FHIR_ResourceType>Medication Administration</FHIR_ResourceType>
        <NCIT>C1097</NCIT>
        <OMOP_Concept_Class_ID>Substance</OMOP_Concept_Class_ID>
        <OMOP_Concept_ID>4304164</OMOP_Concept_ID>
        <OMOP_Concept_Name>Exemestane</OMOP_Concept_Name>
        <OMOP_Concept_code>387017005</OMOP_Concept_code>
